# --- Server ---
PORT=4000
NODE_ENV=development
# Origin of the Next.js storefront (used for CORS and Paystack callback URLs)
WEB_ORIGIN=http://localhost:3000

# --- Database (Neon Postgres) ---
# Use a separate Neon branch (e.g. "dev") on your computer, never the production branch.
# DATABASE_URL: the pooled connection string (host contains "-pooler"). DIRECT_URL: the direct one, for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Auth ---
# Replaced with a random value automatically by `npm run setup` when .env is first created
JWT_SECRET=change-me

# --- Payments ---
# Paystack test keys from https://dashboard.paystack.com/#/settings/developers
# Leave blank to hide the card payment option.
PAYSTACK_SECRET_KEY=

# Bank transfer details shown at checkout, on the order page and in emails (placeholders)
BANK_NAME=Example Bank
BANK_ACCOUNT_NAME=MGK Pharmacy Ltd
BANK_ACCOUNT_NUMBER=0000000000

# Unpaid bank-transfer orders are cancelled automatically after this many hours
UNPAID_ORDER_TTL_HOURS=48

# --- Private uploads (Cloudflare R2) ---
# Required in production. Leave R2_BUCKET empty locally to store files in apps/api/uploads instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Website proxy ---
# Same random value on the API and the website (Vercel), so the API can trust the visitor IP the website forwards.
PROXY_SECRET=

# --- Delivery tracking ---
# Pharmacy location (where deliveries start). PLACEHOLDER: set to the exact coordinates of the store.
STORE_LAT=11.9976
STORE_LNG=8.5154
# Address lookup for delivery pins. The free OpenStreetMap service allows ~1 request/second;
# use a commercial geocoder or self-hosted Nominatim in production.
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Seed accounts (local development only) ---
SEED_ADMIN_EMAIL=admin@mgk.test
SEED_ADMIN_PASSWORD="Admin#Dev2026"
SEED_PHARMACIST_EMAIL=pharmacist@mgk.test
SEED_PHARMACIST_PASSWORD="Pharm#Dev2026"
SEED_CUSTOMER_EMAIL=customer@mgk.test
SEED_CUSTOMER_PASSWORD="Customer#Dev2026"
SEED_RIDER_EMAIL=rider@mgk.test
SEED_RIDER_PASSWORD="Rider#Dev2026"
